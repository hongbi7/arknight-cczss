# Local-only Nginx entry point used before domain filing and HTTPS are ready.
# It lets the deployer verify Nginx's static root without exposing the site.
server {
    listen 127.0.0.1:80;
    server_name _;

    root /opt/arknight-guess/app/public;
    index index.html;

    client_max_body_size 1m;

    location ^~ /api/ {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_connect_timeout 3s;
        proxy_read_timeout 15s;

        add_header Cache-Control "no-store" always;
    }

    location ^~ /img/ {
        try_files $uri =404;
        add_header Cache-Control "public, max-age=86400, stale-while-revalidate=604800";
        access_log off;
    }

    location ~* ^/(css|js|data)/ {
        try_files $uri =404;
        add_header Cache-Control "public, max-age=300, stale-while-revalidate=3600";
    }

    location = /index.html {
        add_header Cache-Control "no-cache";
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
