# Include this complete location block inside the game's server block after
# installing nginx-image-pages-http.conf.example in Nginx's http context.
location ^~ /img/ {
    # A matching release root redirects the browser directly to its immutable
    # Pages deployment. Releases without a verified record stay local.
    if ($arknight_image_origin != "") {
        add_header Cache-Control "no-store" always;
        return 302 $arknight_image_origin$request_uri;
    }

    try_files $uri =404;
    add_header Cache-Control "public, max-age=86400, stale-while-revalidate=604800";
    access_log off;
}
