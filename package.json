{
  "name": "arknight-guess",
  "version": "1.0.0",
  "description": "明日方舟干员猜谜小游戏",
  "private": true,
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "build:data": "python scripts/build_data.py",
    "refresh:attention": "python scripts/refresh_attention_signals.py",
    "build:archives": "python scripts/build_archives.py .handbook-info-table.json",
    "update:data:local": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/update_local.ps1",
    "validate:data": "python scripts/validate_data_update.py --strict-assets --version .update-work/validation-version.json",
    "test": "node lib/game.test.js"
  },
  "engines": {
    "node": "24.x"
  }
}
