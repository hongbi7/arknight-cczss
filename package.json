{
  "name": "arknight-guess",
  "version": "1.0.0",
  "description": "明日方舟干员猜谜小游戏",
  "private": true,
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "build:data": "node scripts/run_data_build.js",
    "refresh:attention": "python scripts/refresh_attention_signals.py",
    "build:archives": "python scripts/build_archives.py .handbook-info-table.json",
    "update:data:local": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/update_local.ps1",
    "validate:data": "python scripts/validate_data_update.py --strict-assets --version .update-work/validation-version.json",
    "validate:production": "python scripts/validate_data_update.py --strict-assets --verify-existing-version --report .update-work/production-validation.json",
    "test": "node lib/game.test.js && node lib/anomaly.test.js && node lib/operator-search.test.js && node lib/endless-easter-eggs.test.js",
    "test:deployment": "node tests/deployment/health.test.js && python -m unittest discover -s tests/deployment -p \"test_*.py\"",
    "build:images:pages": "node scripts/build_image_pages.js",
    "build:portraits": "python scripts/build_portrait_previews.py",
    "check:portraits": "python scripts/build_portrait_previews.py --check",
    "check:images:pages": "node scripts/check_image_pages.js",
    "test:images:pages": "node tests/deployment/image-pages.test.js && node tests/deployment/image-pages-check.test.js && node tests/deployment/image-pages-record.test.js && node tests/deployment/image-pages-contract.test.js",
    "test:e2e": "playwright test",
    "test:e2e:desktop": "playwright test --project=desktop-chromium",
    "test:e2e:mobile": "playwright test --project=mobile-chromium",
    "test:e2e:device": "node scripts/run_mobile_device_tests.js"
  },
  "engines": {
    "node": "24.x"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1"
  }
}
